# Optional. Copy to .env.local only if you need one of these.
# Supabase URL + publishable key already live in src/lib/config.ts (public by design).

# Run the whole site on sample data saved in the browser, no backend:
# NEXT_PUBLIC_DEMO=1

# Point at a different Supabase project:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
